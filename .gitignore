# Python virtual environment
agentic.venv/
env/
venv/
.venv/
ENV/
.env
.env.*

# Note: We want to commit documentation .md files
# Only ignore generated documentation in docs/_build/ and site/ (see below) 

# Python cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build directories
build/
dist/
*.egg-info/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~
.vs/

# Database files
*.sqlite3
*.db

# Logs and temporary files
logs/
*.log
temp/
.DS_Store

# React/Frontend
frontend/build/
frontend/dist/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ML model files
*.h5
*.pkl
*.model
checkpoints/

# Documentation builds
docs/_build/
site/

# Reference PDFs and large binary documents (add manually, don't commit)
docs/references/*.pdf
docs/references/*.docx
docs/references/*.pptx
docs/references/*.xlsx

# Trading data
data/*.csv
data/*.json
*.dat

# AlgoBacktester run outputs (manifest, journal, summary, report per run)
data/backtests/

# Paper-trader runtime state (docker/paper-trader writes these to data/)
data/heartbeat
data/*.err

# Test coverage
.coverage
coverage.xml
.tox/
# AlgoResearch snapshots, caches and explore drafts (AR-D8); hypotheses, reports and the ledger are committed
data/research/
